# Default: auto-detect text, normalize to LF in repo
* text=auto eol=lf

# Explicitly text files → always LF
*.rs        text eol=lf
*.toml      text eol=lf
*.sql       text eol=lf
*.md        text eol=lf
*.json      text eol=lf
*.css       text eol=lf
*.html      text eol=lf
*.scss      text eol=lf
*.sh        text eol=lf
*.env       text eol=lf
*.env.*     text eol=lf
Cargo.lock  text eol=lf

# Binary — jangan disentuh sama sekali
*.webp      binary
*.png       binary
*.jpg       binary
*.jpeg      binary
*.ico       binary
*.wasm      binary
*.pdf       binary
